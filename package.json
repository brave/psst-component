{
  "name": "psst-component-test-typescript",
  "version": "1.0.0",
  "description": "PSST scripts project",
  "scripts": {
    "build": "tsc",
    "prebundle:dev": "ts-node --project scripts/tsconfig.json scripts/generate-psst-config.ts",
    "prebundle:prod": "ts-node --project scripts/tsconfig.json scripts/generate-psst-config.ts",
    "bundle": "webpack --config webpack.config.js --mode development",
    "bundle:dev": "webpack --config webpack.config.js --mode development",
    "bundle:prod": "webpack --config webpack.config.js --mode production",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts' --fix",
    "presubmit": "npm run lint"
  },
  "type": "commonjs",
  "overrides": {
    "ajv": ">=8.18.0",
    "eslint": {
      "ajv": "^6.12.4"
    },
    "fast-uri": "3.1.8",
    "baseline-browser-mapping": "2.11.11",
    "electron-to-chromium": "1.5.399",
    "nanoid": "^3.3.17",
    "node-releases": "2.0.51",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-licenses": "^2.0.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "jsdom": "29.1.1",
    "swf": "1.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.11",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2",
    "webpack-sources": "3.5.0"
  }
}
